{
  "$schema": "https://opencode.ai/config.json",
  "model": "custom/default",
  "autoupdate": true,
  "share": "disabled",
    "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm -rf *": "ask",
      "git push *": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask"
    }
  },
  "plugin": ["oh-my-openagent"],
  "provider": {
    "custom": {
      "models": {
        "default": {
          "limit": {
            "context": 262144,
            "output": 131072
          },
          "name": "llama.cpp"
        }
      },
      "name": "llama.cpp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:LLAMA_API_KEY}",
        "baseURL": "{env:LLAMA_BASE_URL}/v1",
        "chunkTimeout": 3600000,
        "headers": {
          "CF-Access-Client-Id": "{env:CLOUDFLARE_ACCESS_CLIENT_ID}",
          "CF-Access-Client-Secret": "{env:CLOUDFLARE_ACCESS_CLIENT_SECRET}"
        },
        "timeout": 3600000
      }
    }
  }
}
