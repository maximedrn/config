auto-update-channel = tip
font-family = JetBrains Mono
font-size = 14
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
background-opacity = 1
background-blur = false
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
macos-titlebar-style = transparent
macos-option-as-alt = true
window-save-state = always
window-vsync = true
scrollback-limit = 67108864
scrollbar = never
shell-integration = zsh
shell-integration-features = ssh-env,ssh-terminfo,sudo
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
copy-on-select = clipboard
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:down
keybind = cmd+alt+k=goto_split:up
keybind = cmd+alt+l=goto_split:right
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1
keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 45%
quick-terminal-autohide = true
keybind = cmd+shift+r=reload_config
